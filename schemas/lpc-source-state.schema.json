        "response": {
          "anyOf": [
            {
              "$ref": "urn:lpc-companion:state:1#/definitions/response"
            },
            {
              "type": "null"
            }
          ]
        },
        "change": {
          "oneOf": [
            {
              "$ref": "#/definitions/presentationPatch"
            },
            {
              "$ref": "#/definitions/companionReplacement"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "origin": {
            "const": "model"
          }
        }
      },
      "then": {
        "properties": {
          "response": {
            "$ref": "urn:lpc-companion:state:1#/definitions/response"
          }
        }
